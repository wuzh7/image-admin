AI_GATEWAY_TOKEN=replace-with-a-long-random-token
OPENLUX_BASE_URL=https://api.openlux.ai
OPENLUX_API_KEY=replace-with-openlux-key
OPENLUX_MODEL=gemini-3.8-flash
OPENLUX_TIMEOUT_SECONDS=900
GOOGLE_API_KEY=replace-with-rotated-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=900
# Server paths are identical to container paths; only this prompt directory is mounted.
# Copy gemini_prompt.txt.example and relay-prompts/prompt2.txt to the paths below.
# New requests reload both files without restarting, including after file replacement.
GEMINI_PROMPT_FILE=/opt/image-admin-ai-gateway/prompts/gemini_prompt.txt
# Empty path or blank file disables Prompt2 for all RELAY models.
RELAY_PROMPT2_FILE=/opt/image-admin-ai-gateway/prompts/prompt2.txt
RELAY_STAGE2_MODEL=doubao-seed-2-0-lite-260215
AI_GATEWAY_BIND=127.0.0.1
AI_GATEWAY_PORT=18080
