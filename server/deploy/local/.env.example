# 本地 Docker MySQL 初始 root 密码，仅用于本机开发。
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=wuzh-image-admin
MYSQL_USER=root
MYSQL_PASSWORD=root123
# 本地 Redis 密码，仅用于本机开发。
REDIS_PASSWORD=wuzh123
# 本地 Java 堆参数。
BACKEND_JAVA_OPTS=-Xms256m -Xmx3g -Djava.awt.headless=true
# 外部接口和 AI 网关密钥；没有对应服务时保留占位值即可。
ORDER_DETAIL_API_KEY=replace-with-a-long-random-secret
TRO_API_KEY=replace-with-a-different-long-random-secret
OPENLUX_API_KEY=replace-with-openlux-key
# RELAY 模型复用 gemini_prompt.txt，并读取以下第二阶段提示词；留空则跳过查找。
RELAY_PROMPT2_FILE=/app/config/relay-prompts/prompt2.txt
RELAY_STAGE2_MODEL=doubao-seed-2-0-lite-260215
RELAY_STAGE2_PROTOCOL=CHAT_COMPLETIONS
GOOGLE_API_KEY=replace-with-google-key
# Java 与 Node 渲染 Worker 的内部通信密钥。
RENDER_WORKER_TOKEN=replace-with-a-long-random-secret
# 单个渲染 Worker 同时处理的图片数；可按 CPU 和内存调整。
RENDER_WORKER_CONCURRENCY=5
RENDER_WORKER_POLL_MS=2000
# 上架表格中成品图片的固定访问入口；本地 Excel 仅可从这台电脑打开。
STORE_LISTING_PUBLIC_BASE_URL=http://127.0.0.1:8088/prod-api/store/listing-exports/public-results?key=
