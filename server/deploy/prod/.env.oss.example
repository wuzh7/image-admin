# Copy to /data/app/image-admin/.env on ECS and fill locally. Never commit secrets.
MYSQL_HOST=1Panel-mysql-DX2o
MYSQL_PORT=3306
MYSQL_DATABASE=image_admin_prod
MYSQL_USER=image_admin
MYSQL_PASSWORD=
REDIS_HOST=1Panel-redis-Zc5j
REDIS_PORT=6379
REDIS_PASSWORD=
QDRANT_URL=http://image-admin-qdrant:6333
QDRANT_STAGING_COLLECTION=image_sscd_staging_v2
OSS_BUCKET=image-admin-prod-ww
OSS_REGION=cn-hangzhou
OSS_ROLE_NAME=image-admin-prod-ecs-role
# Existing client uses AWS S3 compatible protocol. Do not add the bucket to endpoints.
OSS_ENDPOINT=https://s3.oss-cn-hangzhou-internal.aliyuncs.com
OSS_PUBLIC_ENDPOINT=https://s3.oss-cn-hangzhou.aliyuncs.com
SSCD_MODEL_HOST_PATH=/data/app/image-admin/models/sscd_disc_mixup.torchscript.pt
IMAGE_TASK_WORKERS=1
IMAGE_FEATURE_BATCH_SIZE=8
IMAGE_UPLOAD_CONCURRENCY=16
IMAGE_UPLOAD_POLICY_MINUTES=30
IMAGE_UPLOAD_SESSION_MAX_FILES=1000
AI_GATEWAY_URL=https://replace-with-your-gateway.example.com
AI_GATEWAY_TOKEN=
AI_GATEWAY_TIMEOUT_SECONDS=960
IMAGE_INFRINGEMENT_WORKERS=8
OMP_NUM_THREADS=6
MKL_NUM_THREADS=6
BACKEND_JAVA_OPTS=-Xms2g -Xmx4g -XX:+UseG1GC -Djava.awt.headless=true
HEALTH_USER=health
HEALTH_PASSWORD=
ORDER_DETAIL_API_KEY=
