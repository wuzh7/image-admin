FROM maven:3.9.11-eclipse-temurin-21 AS build

WORKDIR /workspace
COPY . .
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -ntp -Plocal,djl-linux -pl wuzh-admin -am -DskipTests clean package

FROM eclipse-temurin:21-jre-jammy

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home --home-dir /home/app app \
    && mkdir -p /app/logs /data/images /tmp/djl \
    && chown -R app:app /app /data/images /tmp/djl

WORKDIR /app
COPY --from=build --chown=app:app /workspace/wuzh-admin/target/wuzh-admin.jar /app/app.jar
COPY --chown=app:app deploy/image_analysis_prompt.txt /app/config/image_analysis_prompt.txt

ENV TZ=Asia/Shanghai \
    LANG=C.UTF-8 \
    DJL_CACHE_DIR=/tmp/djl

USER app
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
